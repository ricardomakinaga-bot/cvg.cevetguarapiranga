---
import { getCollection, getEntry } from "astro:content";
import BlogCard from "@/components/cards/BlogCard.astro";
import HeroSection from "@/components/HeroSection.astro";
import Layout from "@/components/Layout.astro";

const page = await getEntry("pages", "blog");
if (!page) throw new Error("Missing blog page content");
const posts = await getCollection("blog");
---

<Layout title={page.data.title} description={page.data.description} canonical="/blog/">
  <HeroSection title={page.data.title} description={page.data.description} primaryLabel={page.data.ctaPrimary} secondaryLabel={page.data.ctaSecondary} secondaryHref="/contato" variant="listing" />
  <section class="cvg-section bg-white">
    <div class="cvg-shell">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            category={post.data.category}
            href={`/blog/${post.slug}/`}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
