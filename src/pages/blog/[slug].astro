---
import { getCollection } from "astro:content";
import FAQSection from "@/components/FAQSection.astro";
import HeroSection from "@/components/HeroSection.astro";
import Layout from "@/components/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.description} canonical={`/blog/${entry.slug}/`}>
  <HeroSection title={entry.data.title} description={entry.data.description} primaryLabel={entry.data.cta} secondaryLabel="Falar com a equipe" secondaryHref="/contato" variant="listing" />
  <section class="cvg-section bg-white">
    <div class="cvg-shell">
      <article class="cvg-prose">
        <Content />
      </article>
      {entry.data.clinicalReviewRequired && (
        <p class="mt-8 max-w-3xl rounded-lg border-l-4 border-cvg-emergency bg-cvg-background p-4 text-cvg-muted">
          Conteudo educativo marcado para revisao clinica antes de publicacao final. Nao substitui avaliacao veterinaria.
        </p>
      )}
    </div>
  </section>
  <FAQSection />
</Layout>
