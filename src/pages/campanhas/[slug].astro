---
import { getCollection } from "astro:content";
import HeroSection from "@/components/HeroSection.astro";
import Layout from "@/components/Layout.astro";

export async function getStaticPaths() {
  const campaigns = await getCollection("campaigns");
  return campaigns.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.description} canonical={`/campanhas/${entry.slug}/`}>
  <HeroSection title={entry.data.title} description={entry.data.description} primaryLabel={entry.data.primaryCTA} secondaryLabel="Conhecer servicos" secondaryHref="/servicos" variant="listing" />
  <section class="cvg-section bg-white">
    <div class="cvg-shell grid gap-8 lg:grid-cols-[0.7fr_1.3fr]">
      <aside class="cvg-card p-5">
        <p class="text-sm font-bold uppercase tracking-wide text-cvg-primary">Resumo editorial</p>
        <dl class="mt-4 grid gap-3 text-sm text-cvg-muted">
          <div><dt class="font-bold text-cvg-text">Objetivo</dt><dd>{entry.data.objective}</dd></div>
          <div><dt class="font-bold text-cvg-text">Publico</dt><dd>{entry.data.audience}</dd></div>
          <div><dt class="font-bold text-cvg-text">Canais</dt><dd>{entry.data.channels.join(", ")}</dd></div>
          <div><dt class="font-bold text-cvg-text">Status</dt><dd>{entry.data.status}</dd></div>
        </dl>
      </aside>
      <article class="cvg-prose">
        <Content />
      </article>
    </div>
  </section>
</Layout>
