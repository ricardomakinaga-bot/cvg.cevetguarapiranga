---
import { getCollection } from "astro:content";
import ContentPage from "@/components/ContentPage.astro";
import Layout from "@/components/Layout.astro";
import { canonicalPath } from "@/lib/seo";
import { routeToSlug } from "@/lib/site";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => !["/", "/blog", "/campanhas"].includes(data.route));
  return pages.map((entry) => ({
    params: { slug: routeToSlug(entry.data.route) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.description} canonical={canonicalPath(entry.data.route)}>
  <ContentPage entry={entry} Content={Content} />
</Layout>
