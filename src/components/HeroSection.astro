---
import { contact, trustBadges } from "@/lib/site";
import CTAGroup from "@/components/CTAGroup.astro";
import TrustBadge from "@/components/TrustBadge.astro";

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: "institutional" | "service" | "emergency" | "listing" | "contact";
  showMobileNextCue?: boolean;
}

const {
  eyebrow = "Centro Veterinario Guarapiranga",
  title,
  description,
  primaryLabel = "Falar com a equipe",
  secondaryLabel = "Conhecer servicos",
  secondaryHref = "/servicos",
  variant = "institutional",
  showMobileNextCue = false,
} = Astro.props;
const isEmergency = variant === "emergency";
---

<section class:list={["cvg-hero relative overflow-hidden border-b border-cvg-border bg-cvg-background", isEmergency ? "border-l-4 border-cvg-emergency" : ""]}>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-cvg-light-gradient opacity-75" aria-hidden="true"></div>
  <div class="cvg-shell relative grid gap-8 py-8 md:py-14 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:py-16">
    <div>
      <p class:list={["mb-4 inline-flex rounded-lg border px-3 py-1 text-sm font-bold", isEmergency ? "border-cvg-emergency/40 bg-white text-cvg-deep" : "border-cvg-soft bg-white text-cvg-deep"]}>
        {eyebrow}
      </p>
      <h1 class="max-w-4xl text-4xl font-extrabold leading-tight tracking-normal text-cvg-text md:text-5xl lg:text-6xl">
        {title}
      </h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-cvg-muted">{description}</p>
      <div class="mt-7">
        <CTAGroup
          primaryLabel={primaryLabel}
          primaryHref={contact.whatsappHref}
          secondaryLabel={secondaryLabel}
          secondaryHref={secondaryHref}
        />
      </div>
      <ul class="mt-7 grid grid-cols-2 gap-2 lg:grid-cols-4" aria-label="Sinais de confianca do CVG">
        {trustBadges.map((badge) => <TrustBadge label={badge} />)}
      </ul>
    </div>
    <div class="cvg-hero-media overflow-hidden rounded-lg border border-cvg-border bg-white shadow-cvg">
      <img src="/assets/cvg-institucional.png" alt="Fachada institucional do Centro Veterinario Guarapiranga" class="h-full min-h-[240px] w-full object-cover md:min-h-[360px]" />
      <div class="grid gap-3 border-t border-cvg-border bg-white p-4 sm:grid-cols-3">
        <p class="text-sm text-cvg-muted"><strong class="block text-cvg-deep">24h</strong>Atendimento informado</p>
        <p class="text-sm text-cvg-muted"><strong class="block text-cvg-deep">Caes e gatos</strong>Cuidado veterinario</p>
        <p class="text-sm text-cvg-muted"><strong class="block text-cvg-deep">Zona Sul</strong>Avenida Guarapiranga</p>
      </div>
    </div>
    {showMobileNextCue && (
      <a href="#quando-procurar" class="inline-flex items-center gap-2 text-sm font-bold text-cvg-deep no-underline lg:absolute lg:bottom-6 lg:left-4">
        Ver quando procurar o CVG <span aria-hidden="true">↓</span>
      </a>
    )}
  </div>
</section>
