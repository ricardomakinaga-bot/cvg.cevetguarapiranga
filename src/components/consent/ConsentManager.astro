---
---

<div
  class="consent-banner fixed z-50 hidden rounded-lg border border-cvg-border bg-white shadow-cvg"
  data-consent-banner
>
  <p class="consent-banner-title text-lg font-extrabold text-cvg-text">Privacidade e cookies</p>
  <p class="consent-banner-copy text-sm text-cvg-muted">
    Usamos cookies necessarios para o site funcionar e, com sua permissao, tecnologias de analytics e publicidade para medir campanhas e melhorar a experiencia.
  </p>
  <div class="consent-banner-actions grid gap-2">
    <button class="cvg-button cvg-button-primary px-3 text-sm" type="button" data-consent-accept>Aceitar todos</button>
    <button class="cvg-button cvg-button-secondary px-3 text-sm" type="button" data-consent-reject>Rejeitar opcionais</button>
    <button class="cvg-button cvg-button-secondary px-3 text-sm" type="button" data-consent-open>Personalizar</button>
  </div>
</div>

<dialog class="w-[min(calc(100%-32px),560px)] rounded-lg border border-cvg-border p-0 text-cvg-text shadow-cvg" data-consent-dialog>
  <form method="dialog" class="p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xl font-extrabold">Preferencias de privacidade</p>
        <p class="mt-2 text-sm text-cvg-muted">Categorias opcionais iniciam desativadas e podem ser alteradas a qualquer momento.</p>
      </div>
      <button class="rounded-lg border border-cvg-border px-3 py-2 font-bold" type="button" data-consent-close>Fechar</button>
    </div>
    <div class="mt-5 grid gap-3">
      <div class="rounded-lg border border-cvg-border bg-cvg-background p-4">
        <p class="font-bold">Necessarios</p>
        <p class="text-sm text-cvg-muted">Essenciais para carregar o site e manter preferencias de privacidade.</p>
      </div>
      <label class="flex items-start gap-3 rounded-lg border border-cvg-border p-4">
        <input type="checkbox" name="analytics" class="mt-1 h-5 w-5" />
        <span><strong>Analytics</strong><br /><span class="text-sm text-cvg-muted">Ajuda a entender visitas e interacoes de forma agregada.</span></span>
      </label>
      <label class="flex items-start gap-3 rounded-lg border border-cvg-border p-4">
        <input type="checkbox" name="ads" class="mt-1 h-5 w-5" />
        <span><strong>Publicidade e medicao</strong><br /><span class="text-sm text-cvg-muted">Ajuda a medir campanhas e cliques de contato.</span></span>
      </label>
      <label class="flex items-start gap-3 rounded-lg border border-cvg-border p-4">
        <input type="checkbox" name="personalization" class="mt-1 h-5 w-5" />
        <span><strong>Personalizacao de anuncios</strong><br /><span class="text-sm text-cvg-muted">Permite anuncios mais personalizados em plataformas Google se aprovado.</span></span>
      </label>
    </div>
    <div class="mt-5 grid gap-2 sm:grid-cols-3">
      <button class="cvg-button cvg-button-primary px-3 text-sm" value="save" type="submit">Salvar preferencias</button>
      <button class="cvg-button cvg-button-secondary px-3 text-sm" type="button" data-consent-accept>Aceitar todos</button>
      <button class="cvg-button cvg-button-secondary px-3 text-sm" type="button" data-consent-reject>Rejeitar opcionais</button>
    </div>
  </form>
</dialog>

<div class="fixed bottom-4 left-4 z-50 hidden rounded-lg border border-cvg-border bg-white px-4 py-3 text-sm font-semibold text-cvg-deep shadow-cvg" data-consent-toast>
  Preferencias salvas
</div>

<script>
  // @ts-nocheck
  const KEY = "cvg-consent-v1";
  const banner = document.querySelector("[data-consent-banner]");
  const dialog = document.querySelector("[data-consent-dialog]");
  const toast = document.querySelector("[data-consent-toast]");

  function updateGoogleConsent(consent) {
    if (typeof window.gtag !== "function") return;
    window.gtag("consent", "update", {
      analytics_storage: consent.analytics ? "granted" : "denied",
      ad_storage: consent.ads ? "granted" : "denied",
      ad_user_data: consent.ads ? "granted" : "denied",
      ad_personalization: consent.personalization ? "granted" : "denied",
    });
  }

  function save(consent) {
    localStorage.setItem(KEY, JSON.stringify({ ...consent, savedAt: new Date().toISOString(), policyVersion: "pending-legal-v1" }));
    updateGoogleConsent(consent);
    banner?.classList.add("hidden");
    document.documentElement.dataset.consentVisible = "false";
    if (dialog instanceof HTMLDialogElement) dialog.close();
    toast?.classList.remove("hidden");
    window.setTimeout(() => toast?.classList.add("hidden"), 2200);
  }

  function currentSelection() {
    if (!(dialog instanceof HTMLDialogElement)) return { analytics: false, ads: false, personalization: false };
    const analytics = dialog.querySelector('input[name="analytics"]');
    const ads = dialog.querySelector('input[name="ads"]');
    const personalization = dialog.querySelector('input[name="personalization"]');
    return {
      analytics: Boolean(analytics?.checked),
      ads: Boolean(ads?.checked),
      personalization: Boolean(personalization?.checked),
    };
  }

  const stored = localStorage.getItem(KEY);
  if (stored) {
    try {
      updateGoogleConsent(JSON.parse(stored));
      document.documentElement.dataset.consentVisible = "false";
    } catch {
      banner?.classList.remove("hidden");
      document.documentElement.dataset.consentVisible = "true";
    }
  } else {
    banner?.classList.remove("hidden");
    document.documentElement.dataset.consentVisible = "true";
  }

  document.querySelectorAll("[data-consent-accept]").forEach((button) => {
    button.addEventListener("click", () => save({ analytics: true, ads: true, personalization: true }));
  });
  document.querySelectorAll("[data-consent-reject]").forEach((button) => {
    button.addEventListener("click", () => save({ analytics: false, ads: false, personalization: false }));
  });
  document.querySelectorAll("[data-consent-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
  document.querySelectorAll("[data-consent-close]").forEach((button) => {
    button.addEventListener("click", () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });
  dialog?.addEventListener("submit", (event) => {
    event.preventDefault();
    save(currentSelection());
  });
</script>
