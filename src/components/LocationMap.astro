---
import ContactPanel from "@/components/ContactPanel.astro";
---

<section id="localizacao" class="cvg-section bg-cvg-background">
  <div class="cvg-shell grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-stretch">
    <ContactPanel
      title="Estamos na Avenida Guarapiranga"
      text="Endereco textual permanece visivel mesmo se o mapa externo nao carregar."
    />
    <div class="grid min-h-[320px] place-items-center rounded-lg border border-cvg-border bg-white p-6 text-center text-cvg-muted shadow-sm">
      <div>
        <p class="text-xl font-bold text-cvg-text">Mapa configuravel</p>
        <p class="mt-2 max-w-md">Inserir iframe ou link oficial aprovado sem credenciais privadas no codigo-fonte.</p>
      </div>
    </div>
  </div>
</section>
