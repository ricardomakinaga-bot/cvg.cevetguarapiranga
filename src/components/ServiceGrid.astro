---
import ServiceCard from "@/components/ServiceCard.astro";
import { services } from "@/lib/site";

const groups = [
  {
    title: "Urgencia",
    items: services.filter((service) => service.group === "urgencia"),
  },
  {
    title: "Diagnostico e cuidado",
    items: services.filter((service) => service.group === "diagnostico"),
  },
  {
    title: "Prevencao e rotina",
    items: services.filter((service) => service.group === "rotina"),
  },
];
---

<section id="servicos" class="cvg-section bg-cvg-background">
  <div class="cvg-shell">
    <div class="mb-8 max-w-3xl">
      <p class="cvg-section-eyebrow">Servicos</p>
      <h2 class="text-3xl font-extrabold text-cvg-text">Servicos veterinarios para caes e gatos</h2>
      <p class="mt-3 text-cvg-muted">A indicacao de cada servico depende da avaliacao do paciente e da orientacao da equipe veterinaria.</p>
    </div>
    <div class="grid gap-8">
      {groups.map((group) => (
        <section aria-labelledby={`service-group-${group.title.toLowerCase().replaceAll(" ", "-")}`}>
          <h3 id={`service-group-${group.title.toLowerCase().replaceAll(" ", "-")}`} class="mb-4 text-xl font-extrabold text-cvg-text">{group.title}</h3>
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {group.items.map((service) => <ServiceCard {...service} />)}
          </div>
        </section>
      ))}
    </div>
  </div>
</section>
