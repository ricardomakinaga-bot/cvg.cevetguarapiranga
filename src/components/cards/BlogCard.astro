---
interface Props {
  title: string;
  href: string;
  description: string;
  category?: string;
}

const { title, href, description, category } = Astro.props;
---

<article class="cvg-card cvg-interactive-card flex h-full flex-col border-t-4 border-t-cvg-primary p-5">
  {category && <p class="cvg-intent-chip mb-3 w-fit">{category}</p>}
  <h2 class="text-xl font-extrabold leading-snug text-cvg-text">{title}</h2>
  <p class="mt-3 flex-1 text-cvg-muted">{description}</p>
  <p class="mt-4 rounded-lg border border-cvg-primary/20 bg-cvg-clinical px-3 py-2 text-sm font-semibold text-cvg-deep">Nao substitui avaliacao veterinaria.</p>
  <a class="mt-5 font-bold text-cvg-deep no-underline hover:text-cvg-primary" href={href}>Ler orientacao</a>
</article>
