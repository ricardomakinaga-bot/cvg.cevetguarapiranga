---
interface Props {
  title: string;
  href: string;
  description: string;
  service: string;
  status: string;
}

const { title, href, description, service, status } = Astro.props;
---

<article class="cvg-card flex h-full flex-col p-5">
  <p class="mb-2 text-sm font-bold uppercase tracking-wide text-cvg-primary">{service}</p>
  <h2 class="text-xl font-extrabold leading-snug text-cvg-text">{title}</h2>
  <p class="mt-3 flex-1 text-cvg-muted">{description}</p>
  <p class="mt-4 text-sm font-semibold text-cvg-muted">Status editorial: {status}</p>
  <a class="mt-5 font-bold text-cvg-deep no-underline hover:text-cvg-primary" href={href}>Ver campanha</a>
</article>
