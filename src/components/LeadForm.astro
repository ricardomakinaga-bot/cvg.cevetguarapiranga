---
import ContactPanel from "@/components/ContactPanel.astro";
---

<section id="contato" class="cvg-section bg-white">
  <div class="cvg-shell grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <ContactPanel
      title="Fale com a equipe do CVG"
      text="Envie sua mensagem para orientarmos o melhor canal de atendimento para seu cao ou gato. Se houver sinais importantes ou piora repentina, procure avaliacao veterinaria."
      compact
    />
    <form class="cvg-card grid gap-4 p-5" data-lead-form novalidate>
      <div>
        <label class="mb-1 block font-bold text-cvg-text" for="name">Seu nome</label>
        <input class="min-h-11 w-full rounded-lg border border-cvg-border px-3 py-2" id="name" name="name" autocomplete="name" required />
      </div>
      <div>
        <label class="mb-1 block font-bold text-cvg-text" for="phone">WhatsApp ou telefone</label>
        <input class="min-h-11 w-full rounded-lg border border-cvg-border px-3 py-2" id="phone" name="phone" autocomplete="tel" required />
      </div>
      <div>
        <label class="mb-1 block font-bold text-cvg-text" for="petName">Nome do pet</label>
        <input class="min-h-11 w-full rounded-lg border border-cvg-border px-3 py-2" id="petName" name="petName" autocomplete="off" />
      </div>
      <div>
        <label class="mb-1 block font-bold text-cvg-text" for="species">Cao ou gato?</label>
        <select class="min-h-11 w-full rounded-lg border border-cvg-border px-3 py-2" id="species" name="species" required>
          <option value="">Selecione</option>
          <option>Cao</option>
          <option>Gato</option>
        </select>
      </div>
      <div>
        <label class="mb-1 block font-bold text-cvg-text" for="reason">Motivo do contato</label>
        <select class="min-h-11 w-full rounded-lg border border-cvg-border px-3 py-2" id="reason" name="reason" required>
          <option value="">Selecione</option>
          <option>Atendimento 24h</option>
          <option>Consulta ou check-up</option>
          <option>Exame ou laboratorio</option>
          <option>Vacinas</option>
          <option>Banho e tosa</option>
          <option>Outro motivo</option>
        </select>
      </div>
      <div>
        <label class="mb-1 block font-bold text-cvg-text" for="message">Conte brevemente o que voce precisa</label>
        <textarea class="min-h-28 w-full rounded-lg border border-cvg-border px-3 py-2" id="message" name="message" aria-describedby="message-help"></textarea>
        <p id="message-help" class="mt-2 text-sm text-cvg-muted">Se houver sinais importantes, procure atendimento veterinario. O formulario nao substitui avaliacao urgente.</p>
      </div>
      <label class="flex gap-3 text-sm text-cvg-muted">
        <input type="checkbox" required class="mt-1 h-4 w-4" />
        <span>Ao enviar, voce autoriza o contato da equipe do CVG para responder sua solicitacao.</span>
      </label>
      <p class="hidden rounded-lg border border-cvg-alert/40 bg-white p-3 text-sm text-cvg-alert" data-form-error>
        Preencha nome, contato, especie, motivo e consentimento antes de enviar.
      </p>
      <p class="hidden rounded-lg border border-cvg-primary/30 bg-cvg-clinical p-3 text-sm font-semibold text-cvg-deep" data-form-success>
        Mensagem recebida. A equipe do CVG retornara pelo canal informado.
      </p>
      <button class="cvg-button cvg-button-primary w-full" type="submit">Enviar mensagem</button>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll("[data-lead-form]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const leadForm = event.currentTarget;
      if (!(leadForm instanceof HTMLFormElement)) return;
      const error = leadForm.querySelector("[data-form-error]");
      const success = leadForm.querySelector("[data-form-success]");
      const valid = leadForm.checkValidity();
      error?.classList.toggle("hidden", valid);
      success?.classList.toggle("hidden", !valid);
      document.documentElement.dataset.leadFeedbackVisible = "true";
      if (valid) leadForm.reset();
    });
  });
</script>
