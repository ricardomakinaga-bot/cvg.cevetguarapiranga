---
interface Props {
  title: string;
  href: string;
  summary: string;
  image?: string;
  group?: string;
}

const { title, href, summary, image, group = "diagnostico" } = Astro.props;
const isEmergency = group === "urgencia";
const chip = isEmergency ? "Urgencia" : group === "rotina" ? "Prevencao e rotina" : "Diagnostico e cuidado";
const linkLabel = isEmergency ? "Entender atendimento 24h" : "Ver servico";
---

<article class:list={["cvg-card cvg-interactive-card flex h-full flex-col overflow-hidden", isEmergency ? "border-l-4 border-l-cvg-emergency" : "border-t-4 border-t-cvg-primary"]}>
  {image && (
    <div class="relative aspect-[4/3] overflow-hidden bg-cvg-background">
      <img src={image} alt="" class="h-full w-full object-cover" loading="lazy" />
      <div class="pointer-events-none absolute inset-0 bg-cvg-primary/10" aria-hidden="true"></div>
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    <p class:list={[isEmergency ? "cvg-emergency-chip" : "cvg-intent-chip"]}>{chip}</p>
    <h3 class="mt-3 text-xl font-bold text-cvg-text">{title}</h3>
    <p class="mt-2 flex-1 text-cvg-muted">{summary}</p>
    <p class="mt-4 text-sm font-semibold text-cvg-muted">Indicacao conforme avaliacao veterinaria.</p>
    <a href={href} class="mt-4 font-bold text-cvg-deep no-underline hover:text-cvg-primary">{linkLabel}</a>
  </div>
</article>
